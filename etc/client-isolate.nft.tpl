# Client isolation: drop L2 forwarding between LAN ports.
# Generated by /etc/init.d/client-isolate (Ver 2.94).
#  - router MAC: luon cho qua (gateway/DHCP/DNS)
#  - master: MAC trong set @master thay + dieu khien MOI may (accept ca saddr lan daddr)
#            192.10.1.10 (may quan ly) khoa cung trong init, khong bo duoc
#  - allow : MAC ngoai le, chi noi chuyen duoc voi nhau (saddr VA daddr deu trong set)
table bridge client_isolate {
	set master {
		type ether_addr
		__MASTER_ELEMS__
	}
	set allow {
		type ether_addr
		__ALLOW_ELEMS__
	}
	chain lan_fwd {
		type filter hook forward priority 0; policy accept;
		ether saddr __ROUTER_MAC__ accept
		ether daddr __ROUTER_MAC__ accept
		ether saddr @master accept
		ether daddr @master accept
		ether saddr @allow ether daddr @allow accept
		counter drop
	}
}
