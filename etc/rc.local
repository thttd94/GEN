# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

/etc/genrouter_fix_fw.sh
# [golden-image-firstboot] may moi: /data thieu fs -> tu mkfs + gieo lai du lieu VPN
(
sleep 12
if ! grep -q ' /data ' /proc/mounts; then
  mount /dev/sda4 /data 2>/dev/null || { mkfs.ext4 -F /dev/sda4 >/dev/null 2>&1; mount /dev/sda4 /data; }
fi
mkdir -p /data/vpn
if [ -f /root/data_seed.tar.gz ] && [ ! -f /data/.seed_done ]; then
  tar xzf /root/data_seed.tar.gz -C /
  touch /data/.seed_done
fi
) &

# [killswitch] khong qua proxy/VPN => khong ra WAN
(sleep 25; /etc/genrouter_killswitch.sh) &
exit 0

